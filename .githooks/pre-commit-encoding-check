#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
pre-commit-encoding-check v2.0.0 -- Validation UTF-8 stricte
IntentHash: 0xPRE_COMMIT_ENCODING_CHECK_20260603 (migré: 0xENCODING_UTF8_MIGRATION_20260823)

HISTORIQUE:
  v1.0.0 (2026-06): bloquait tout U+0100+ hors CP1252 (ENV2 Windows legacy).
  v2.0.0 (2026-08-23): arbitrage HITL U-C7 Option A -- UTF-8 PARTOUT.
    Raison: le CP1252 bloquait l'écriture française légitime (em-dash,
    box-drawing des arbres, flèches) dans les artefacts de gouvernance.
    Contrat: unified-design/conventions/ENCODAGE_UTF8.md (design U-C7).

NOUVELLE POLITIQUE:
  - BLOQUE: fichier non décodable en UTF-8 strict (encodage mixte/corrompu)
  - BLOQUE: caractères de contrôle invisibles toxiques (zero-width, BOM interne)
  - WARN (non bloquant): pictogrammes décoratifs U+1F300+ (usage à limiter)
  - ACCEPTE: toute typo UTF-8 légitime -- accents FR, em-dash, box-drawing,
    flèches, symboles techniques

Extensions vérifiées: *.yaml *.yml *.md *.sh *.ps1
Tolérées: docs/, DOCS/ (narratif), BOM initial en tête de fichier.
"""

import os
import re
import sys
from pathlib import Path

VERSION = "2.0.0"
INTENT_HASH = "0xENCODING_UTF8_MIGRATION_20260823"

CHECKED_EXTENSIONS = {".yaml", ".yml", ".md", ".sh", ".ps1"}
TOLERATED_DIRS = {"docs/", "DOCS/", "html/", "HTML/"}

# Caracteres de controle invisibles toxiques (jamais legitimes dans du texte)
TOXIC_INVISIBLES = re.compile(r"[\u200B-\u200D\u2060\uFEFF]")

# Pictogrammes decoratifs (warning, non bloquant)
DECOR_PICTOGRAPHS = re.compile(r"[\U0001F300-\U0001FAFF\u2600-\u26FF\u2700-\u27BF]")


def iter_staged_files(repo_root):
    out = subprocess_run_git(repo_root, ["diff", "--cached", "--name-only", "--diff-filter=ACMR"])
    for line in out.splitlines():
        line = line.strip()
        if not line:
            continue
        p = Path(repo_root) / line
        if p.suffix.lower() in CHECKED_EXTENSIONS and not is_tolerated(line):
            yield line, p


def is_tolerated(relpath):
    rp = relpath.replace("\\", "/")
    return any(rp.startswith(d) or f"/{d}" in rp for d in TOLERATED_DIRS)


def subprocess_run_git(cwd, args):
    import subprocess as sp
    res = sp.run(["git"] + args, cwd=cwd, capture_output=True, text=True,
                 encoding="utf-8", errors="replace")
    return res.stdout or ""


def check_file(relpath, path):
    """Retourne (bloquants, warnings)."""
    blocked, warns = [], []
    try:
        raw = path.read_bytes()
    except OSError as e:
        blocked.append(f"lecture impossible: {e}")
        return blocked, warns

    if not raw:
        return blocked, warns

    # 1. UTF-8 strict
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError as e:
        # BOM UTF-8 en tete tolere
        if raw.startswith(b"\xef\xbb\xbf"):
            try:
                raw[3:].decode("utf-8")
                warns.append("BOM UTF-8 present (tolere, a retirer a terme)")
                return blocked, warns
            except UnicodeDecodeError:
                pass
        blocked.append(f"UTF-8 invalide (octet {e.start:#x}): {e.reason}")
        return blocked, warns

    # 2. Invisibles toxiques
    for m in TOXIC_INVISIBLES.finditer(text):
        name = {"\u200B": "ZERO-WIDTH SPACE", "\u200C": "ZWNJ",
                "\u200D": "ZWJ", "\u2060": "WORD JOINER",
                "\uFEFF": "BOM INTERNE"}.get(m.group(0), "INVISIBLE")
        line_no = text.count("\n", 0, m.start()) + 1
        blocked.append(f"L{line_no}: {name} (U+{ord(m.group(0)):04X})")

    # 3. Pictogrammes decoratifs -> warning
    decors = DECOR_PICTOGRAPHS.findall(text)
    if decors:
        warns.append(f"{len(decors)} pictogramme(s) decoratif(s) (limiter l'usage)")

    return blocked, warns


def main():
    repo_root = os.getcwd()
    # remonter a la racine git
    while not os.path.isdir(os.path.join(repo_root, ".git")):
        parent = os.path.dirname(repo_root)
        if parent == repo_root:
            print("[ENCODING v2] racine .git introuvable")
            sys.exit(0)
        repo_root = parent

    total_blocked, total_warns = [], []
    for relpath, path in iter_staged_files(repo_root):
        b, w = check_file(relpath, path)
        for item in b:
            total_blocked.append(f"{relpath}: {item}")
        for item in w:
            total_warns.append(f"{relpath}: {item}")

    for warn in total_warns:
        print(f"[ENCODING WARN] {warn}")

    if total_blocked:
        print(f"[ENCODING BLOCK] {len(total_blocked)} probleme(s) UTF-8 detecte(s)")
        print(f"[ENCODING BLOCK] IntentHash: {INTENT_HASH}")
        for item in total_blocked[:10]:
            print(f"  {item}")
        if len(total_blocked) > 10:
            print(f"  ... (+{len(total_blocked) - 10})")
        sys.exit(1)

    print(f"[ENCODING v{VERSION}] OK -- UTF-8 valide sur tous les fichiers stages")


if __name__ == "__main__":
    main()
