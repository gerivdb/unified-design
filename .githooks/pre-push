#!/bin/bash
# pre-push hook — Branch Taxonomy Enforcement
# Bloque le push si la branche ne respecte pas la taxonomy autorisée.

set -euo pipefail

BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Taxonomie canonique unifiée (session 2026-10-11).
# Cette liste DOIT rester identique aux types acceptés par .githooks/commit-msg,
# sinon un message de commit valide peut porter un préfixe de branche refusé ici.
# Référence : ADR-2026-10-11-002 (safe-deletion-subsystems), outillage.
ALLOWED_PREFIXES="^(feat|fix|refactor|docs|chore|adr|break|test|style|wip|hotfix)/"

if [[ ! "$BRANCH" =~ $ALLOWED_PREFIXES ]]; then
  echo "[HOOK] Branche '$BRANCH' ne respecte pas la taxonomy autorisée."
  echo "[HOOK] Préfixes autorisés: feat/ | fix/ | refactor/ | docs/ | chore/ | adr/ | break/ | test/ | style/ | wip/ | hotfix/"
  exit 1
fi

echo "[HOOK] Branch taxonomy OK: $BRANCH"
exit 0
