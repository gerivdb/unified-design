{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dual-Path RBF/LLM Engine",
  "type": "object",
  "required": ["input", "output", "threshold", "latency_budget_ms"],
  "properties": {
    "input": {
      "type": "object",
      "required": ["prompt", "top_k", "timeout_ms"],
      "properties": {
        "prompt": {"type": "string"},
        "top_k": {"type": "integer", "minimum": 1},
        "timeout_ms": {"type": "integer", "minimum": 1}
      }
    },
    "output": {
      "type": "object",
      "required": ["status", "latency_ms", "distance", "confidence", "response"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["fast_path", "slow_path", "fallback"]
        },
        "latency_ms": {"type": "number", "maximum": 3},
        "distance": {"type": "number"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "response": {"type": "string"},
        "html": {"type": ["string", "null"]},
        "db_query": {"type": ["string", "null"]}
      }
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Seuil de confiance τ pour le routage fast-path"
    },
    "latency_budget_ms": {
      "type": "integer",
      "maximum": 3,
      "description": "Budget latence maximal pour le fast-path"
    }
  }
}
