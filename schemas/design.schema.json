{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gerivdb.github.io/unified-design/schemas/design.schema.json",
  "title": "Unified Design Schema",
  "description": "Schema for validating design YAML files in unified-design/designs/. Enforces universal naming, depends_on contracts, and bridges declarations.",
  "type": "object",
  "required": [
    "name",
    "version",
    "status",
    "layer",
    "intent_hash"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Universal design name (no repo-specific naming)."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the design."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "draft",
        "proposed"
      ],
      "description": "Lifecycle status of the design."
    },
    "layer": {
      "type": "string",
      "description": "Universal layer scope (e.g. L0, L1-L4, L2-PLATFORM)."
    },
    "intent_hash": {
      "type": "string",
      "pattern": "^0x[a-zA-Z0-9_-]+$",
      "description": "Unique intent hash for governance traceability."
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the design."
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ATOM-[0-9]+-[a-z0-9-]+$"
      },
      "description": "List of atom IDs this design depends on."
    },
    "bridges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "role",
          "protocol"
        ],
        "properties": {
          "target": {
            "type": "string",
            "description": "Target repo or system name (universal, not repo-specific)."
          },
          "role": {
            "type": "string",
            "enum": [
              "consumer",
              "provider",
              "bidirectional"
            ],
            "description": "Role of the target in relation to this design."
          },
          "protocol": {
            "type": "string",
            "description": "Integration protocol (e.g. python-import, rest-api, mcp)."
          }
        }
      },
      "description": "Bridges to consuming/providing systems."
    },
    "inherits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of parent design names this design inherits from."
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "description": "Capabilities provided by this design."
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true,
      "description": "Arbitrary parameters for design instantiation."
    },
    "performance": {
      "type": "object",
      "properties": {
        "latency_p99": {
          "type": "number"
        },
        "power_max": {
          "type": "number"
        }
      },
      "description": "Performance constraints."
    },
    "components": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object"
          }
        ]
      },
      "description": "Logical components of the design."
    },
    "constraints": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              }
            ]
          }
        },
        {
          "type": "object",
          "additionalProperties": true
        }
      ],
      "description": "Hard constraints enforced by the design."
    },
    "citizen": {
      "type": "string"
    },
    "source_repo": {
      "type": "string"
    },
    "source_path": {
      "type": "string"
    },
    "stratum": {
      "type": "string"
    },
    "created": {
      "type": "string"
    },
    "cycle": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      ]
    },
    "states": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object"
          }
        ]
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object"
          }
        ]
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object"
          }
        ]
      }
    },
    "integration": {
      "type": [
        "string",
        "object"
      ]
    },
    "matheme": {
      "type": [
        "string",
        "object"
      ]
    },
    "date": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "bdcp_mode": {
      "type": [
        "string",
        "object"
      ]
    },
    "statuses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
