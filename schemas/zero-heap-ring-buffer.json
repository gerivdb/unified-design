{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Zero-Heap Ring Buffer & Synchronous Pipeline",
  "type": "object",
  "required": ["ring_buffer", "pipeline"],
  "properties": {
    "ring_buffer": {
      "type": "object",
      "required": ["capacity", "element_size", "total_memory_bytes"],
      "properties": {
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "description": "Puissance de 2 pour CAS lock-free"
        },
        "element_size": {
          "type": "integer",
          "minimum": 1,
          "description": "Taille d'un élément en octets"
        },
        "total_memory_bytes": {
          "type": "integer",
          "maximum": 65536,
          "description": "Mémoire totale allouée statiquement"
        }
      }
    },
    "pipeline": {
      "type": "object",
      "required": ["frequency_hz", "cycle_time_ms", "workers_max"],
      "properties": {
        "frequency_hz": {
          "type": "integer",
          "maximum": 30,
          "description": "Fréquence du pipeline (Hz)"
        },
        "cycle_time_ms": {
          "type": "integer",
          "maximum": 33,
          "description": "Temps de cycle par étape (ms)"
        },
        "workers_max": {
          "type": "integer",
          "maximum": 16,
          "description": "Nombre maximum de workers"
        }
      }
    },
    "constraints": {
      "type": "object",
      "required": ["heap_allocation", "locks_allowed"],
      "properties": {
        "heap_allocation": {
          "type": "boolean",
          "const": false,
          "description": "Interdiction d'allocation dynamique"
        },
        "locks_allowed": {
          "type": "boolean",
          "const": false,
          "description": "Interdiction de locks, CAS uniquement"
        }
      }
    }
  }
}
