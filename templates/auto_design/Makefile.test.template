.PHONY: test lint format coverage clean

test:
	pytest tests/ -q --tb=short

lint:
	ruff check .
	ruff format --check .

format:
	ruff format .

coverage:
	pytest --cov=src --cov-report=term --cov-fail-under=80

clean:
	rm -rf .pytest_cache .ruff_cache htmlcov .coverage
	find . -type d -name __pycache__ -exec rm -rf {} +
